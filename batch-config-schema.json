{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch Configuration Schema",
  "type": "object",
  "required": [
    "global",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "concurrency": {
          "$ref": "#/definitions/setting"
        },
        "mergeWidth": {
          "$ref": "#/definitions/setting"
        },
        "defaultModel": {
          "type": "string",
          "description": "Default AI model to use if not specified per-task or via CLI"
        }
      }
    },
    "tasks": {
      "type": "object",
      "properties": {
        "condense": {
          "$ref": "#/definitions/taskConfig"
        },
        "discoverThemes": {
          "$ref": "#/definitions/taskConfig"
        },
        "extractThemeContent": {
          "$ref": "#/definitions/taskConfig"
        },
        "summarizeThemes": {
          "$ref": "#/definitions/taskConfig"
        },
        "discoverEntities": {
          "$ref": "#/definitions/entityTaskConfig"
        }
      }
    }
  },
  "definitions": {
    "setting": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "batchConfig": {
      "type": "object",
      "required": [
        "triggerWordLimit",
        "batchWordLimit"
      ],
      "properties": {
        "triggerWordLimit": {
          "type": "integer",
          "description": "Total word count that triggers batching"
        },
        "batchWordLimit": {
          "type": "integer",
          "description": "Target words per batch"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "taskConfig": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "mergeWidth": {
          "type": "integer"
        },
        "model": {
          "type": "string",
          "description": "AI model to use for this task"
        },
        "batching": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/batchConfig"
            }
          ]
        },
        "validation": {
          "type": "object"
        },
        "thresholds": {
          "type": "object"
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per-role models within the task (getTaskRoleModel), e.g. discoverThemes: batch/merge; summarizeThemes: summary/merge/structure"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "entityTaskConfig": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "model": {
          "type": "string",
          "description": "AI model to use for this task"
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "minUnitsCap": {
              "type": "integer",
              "description": "Keep an entity found in at least min(1% of units, minUnitsCap) units"
            },
            "wordsPerCall": {
              "type": "integer",
              "description": "Words of comment text per base and theme call"
            },
            "sweepWordsPerCall": {
              "type": "integer",
              "description": "Words per sweep call; the sweep reads every unit no earlier call read, plus the rest of long letters"
            },
            "maxWordsPerUnit": {
              "type": "integer",
              "description": "Long letters are truncated to this many words in base and theme calls; the sweep reads the rest as further pieces"
            },
            "typedShare": {
              "type": "number",
              "description": "Share of a theme or sweep call's words given to short typed comments (the rest to long and attachment letters)"
            },
            "longMinWords": {
              "type": "integer",
              "description": "Units with attachments or more than this many words count as long letters"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "stages": {
          "type": "object",
          "properties": {
            "categoryDiscovery": {
              "type": "object",
              "properties": {
                "mergeWidth": {
                  "type": "integer"
                },
                "model": {
                  "type": "string",
                  "description": "Override model for this stage"
                },
                "batching": {
                  "$ref": "#/definitions/batchConfig"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            "entityExtraction": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "description": "Override model for this stage"
                },
                "batching": {
                  "$ref": "#/definitions/batchConfig"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
